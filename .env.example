# Copy to .env (never committed). All optional; defaults shown.
PORT=3000
DATA_DIR=data
# DATABASE_URL=sqlite://data/mnemo.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_MODE=local
# Local embedding server (M2): any OpenAI-compatible /v1/embeddings endpoint.
EMBEDDINGS_URL=http://127.0.0.1:11434/v1
EMBEDDINGS_MODEL=bge-m3
RUST_LOG=info,mnemo=debug
