{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemo.dev/schemas/library.schema.json",
  "title": "Mnemo library manifest (library.yaml)",
  "description": "Shared, read-only reference data (docs/PLAN.md: Setup, libraries and starters). Records live next to the manifest in records.jsonl, one JSON object per line with a stable `record_id`. Changing this file requires an ADR.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "name", "license", "attribution", "record_schema"],
  "properties": {
    "kind": { "const": "library" },
    "id": { "type": "string", "pattern": "^@[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "license": { "type": "string", "minLength": 1, "description": "SPDX id, e.g. CC-BY-SA-4.0" },
    "attribution": { "type": "string", "minLength": 1, "description": "Shown in the app wherever records are used." },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "license"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "license": { "type": "string" }
        }
      }
    },
    "record_schema": { "type": "object", "description": "JSON Schema every record must satisfy." },
    "search_fields": { "type": "array", "items": { "type": "string" } },
    "rank_field": { "type": "string" }
  }
}
